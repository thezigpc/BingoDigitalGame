{
  "id": "bingo",
  "name": "Bingo",
  "version": "0.5.0",
  "image": "ghcr.io/thezigpc/bingo:0.5.0",
  "port": 3002,
  "sdk": { "version": "0.10.0", "level": 3 },
  "routing": { "basePath": true },
  "routes": {
    "player": "/",
    "table": "/join/{code}?as=table",
    "host": "/",
    "admin": "/admin"
  },
  "health": "/health",
  "events": ["room_created", "room_closed", "players_changed", "round_started", "round_ended", "claim_pending", "winner"],
  "commands": ["create_room", "start", "pause", "resume", "next_round", "end", "confirm_claim", "reject_claim"],
  "brandable": ["displayName", "tagline"],
  "sessionKinds": ["venue", "patron", "private"],
  "resources": { "memory": "256m", "cpus": 1 },
  "network": { "internet": false },
  "env": { "DATA_DIR": "/data" }
}
